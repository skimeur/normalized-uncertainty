# ---------------------------------------------------------------------------
# No data is distributed with this repository (see data/README.md): every raw
# source is downloaded from its official home and every derived file is built
# locally by the code here.
# ---------------------------------------------------------------------------
data/raw/
data/derived/
*.csv
*.xlsx
*.xls
*.parquet
*.dta
*.pkl
*.feather
!papers/*/results/*.csv
# The scenario matrices transcribed from published NY Fed PDFs travel with the second paper's package.
!papers/*/inputs/*.csv

# Generated exhibits: the figure PDFs and the table files are committed, because they are the files the
# manuscripts embed; the PNG previews are rebuilt by the scripts and stay local.
papers/*/figures/*.png

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and systems
.DS_Store
.vscode/
.idea/
